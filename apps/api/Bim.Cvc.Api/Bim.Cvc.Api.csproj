<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bim.Cvc.Domain\Bim.Cvc.Domain.csproj" />
    <ProjectReference Include="..\Bim.Cvc.Application\Bim.Cvc.Application.csproj" />
    <ProjectReference Include="..\Bim.Cvc.Infrastructure\Bim.Cvc.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Projects\Fonts\LiberationSans-Regular.ttf">
      <LogicalName>Bim.Cvc.Api.Projects.Fonts.LiberationSans-Regular.ttf</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Projects\Fonts\LiberationSans-Bold.ttf">
      <LogicalName>Bim.Cvc.Api.Projects.Fonts.LiberationSans-Bold.ttf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
